<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReadyCode.Avalonia.Views.SettingsWindow"
        Title="Preferences"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="14">

        <TextBlock Text="VICE emulator" FontWeight="Bold" />
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Emulator executable (x64sc)" />
            <TextBox   Grid.Row="1" Grid.Column="0" x:Name="VicePathBox" PlaceholderText="/opt/homebrew/bin/x64sc" />
            <Button    Grid.Row="1" Grid.Column="1" Content="Browse…" Click="Browse_Click" />
        </Grid>
        <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Binary monitor host" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Port" />
            <TextBox   Grid.Row="1" Grid.Column="0" x:Name="MonitorHostBox" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="MonitorPortBox" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
        </Grid>
        <CheckBox x:Name="BringToForegroundBox" Content="Bring VICE to the foreground after loading or running" />
        <CheckBox x:Name="MinifyOnTransferBox" Content="Minify BASIC before transferring (uses the WPF app's minify settings)" />

        <TextBlock Text="Editor" FontWeight="Bold" Margin="0,10,0,0" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="4">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Font size" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Line number padding (digits, 0 = none)" />
            <NumericUpDown Grid.Row="1" Grid.Column="0" x:Name="FontSizeBox" Minimum="8" Maximum="48" Increment="1" FormatString="0" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="LineNumberPaddingBox" Minimum="0" Maximum="5" Increment="1" FormatString="0" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="Cancel_Click" />
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="Ok_Click" />
        </StackPanel>

    </StackPanel>
</Window>
