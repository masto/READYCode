<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ReadyCode.Avalonia.Views.DisassemblyToolbarControl"
             Background="{DynamicResource ThemePanelHeaderBg}">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemePanelHeaderFg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSettingsBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeSettingsLabelFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeSettingsBtnBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeSettingsBtnHoverBg}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Width" Value="80" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="Menlo,Consolas,DejaVu Sans Mono,monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <!-- Start/End of the memory range to read from the machine and disassemble; Enter in either
         box or the button runs it. -->
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,6">
        <TextBlock Text="Start:" />
        <TextBox x:Name="StartAddressBox" Text="$0801" />
        <TextBlock Text="End:" />
        <TextBox x:Name="EndAddressBox" Text="$0900" />
        <Button x:Name="DisassembleButton" Content="Disassemble" MinHeight="0" Padding="10,3" FontSize="12" Click="DisassembleButton_Click" />
    </StackPanel>
</UserControl>
